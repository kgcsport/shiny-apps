{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lightweight-teaching-apps-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "LIVE_WORDCLOUD", "class_name": "LiveWordcloudRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_classes": ["LiveWordcloudRoom"] }]
}
